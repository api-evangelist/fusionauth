{
  "opencollection": "1.0.0",
  "info": {
    "name": "FusionAuth Api Key System Configuration API",
    "version": "1.66.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "System Configuration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "updateSystemConfigurationWithId",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://localhost:9011/api/system-configuration",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the system configuration."
        },
        {
          "info": {
            "name": "patchSystemConfigurationWithId",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "http://localhost:9011/api/system-configuration",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates, via PATCH, the system configuration."
        }
      ]
    }
  ],
  "bundled": true
}