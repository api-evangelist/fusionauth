{
  "opencollection": "1.0.0",
  "info": {
    "name": "FusionAuth Api Key Health API",
    "version": "1.66.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "retrieveSystemHealthWithId",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:9011/api/health"
          },
          "docs": "Retrieves the FusionAuth system health. This API will return 200 if the system is healthy, and 500 if the system is un-healthy."
        }
      ]
    }
  ],
  "bundled": true
}