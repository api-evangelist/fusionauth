          "name": "create Logout",
          "request": {
            "name": "create Logout",
            "description": {
              "content": "The Logout API is intended to be used to remove the refresh token and access token cookies if they exist on the client and revoke the refresh token stored. This API takes the refresh token in the JSON body. OR The Logout API is intended to be used to remove the refresh token and access token cookies if they exist on the client and revoke the refresh token stored. This API does nothing if the request does not contain an access token or refresh token cookies.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "logout"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "global",
                  "value": "<string>",
                  "description": "When this value is set to true all the refresh tokens issued to the owner of the provided token will be revoked."
                },
                {
                  "disabled": false,
                  "key": "refreshToken",
                  "value": "<string>",
                  "description": "The refresh_token as a request parameter instead of coming in via a cookie. If provided this takes precedence over the cookie."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
