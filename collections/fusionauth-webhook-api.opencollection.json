            "url": "http://localhost:9011/api/webhook/:webhookId",
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path",
                "description": "The Id of the webhook to update."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
